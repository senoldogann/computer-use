# Python
.venv/
__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Rust
driver/target/

# Runtime sockets
*.sock

# Secrets — the OpenAI key lives in ~/.computeruse/env or a local .env,
# and neither may ever reach the repository.
.env
.env.*
!.env.example

# macOS
.DS_Store

# Caches written into this checkout by editors and agent tooling. Named
# individually because an ignore rule has to name the directory it ignores;
# none of them are part of this project.
.ccm/
.freebuff/
data/

# Third-party agent-tooling scaffolding vendored by local tools, not project
# source (same reason `data/` is ignored: it is a cache of someone else's repo).
.agents/
skills/
skills-lock.json